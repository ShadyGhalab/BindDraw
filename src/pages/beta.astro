---
import '../styles/global.css';
import { games, groupUrl, portalUrl } from '../data/beta.mjs';
const base = import.meta.env.BASE_URL;
const title = 'Android Beta Testers | ShadyGhalabs';
const description = 'Join our Android testing community, try Invisible Ink and Teddy Dreams, and help shape future games.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#100c1e" />
    <meta name="referrer" content="no-referrer" />
    <link rel="canonical" href={portalUrl} />
    <link rel="icon" type="image/png" href={base + 'images/app-icon.png'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={portalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://blinddraw.ink/images/app-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="beta-header">
      <div class="shell header-inner">
        <a class="brand" href={portalUrl}>
          <span class="brand-mark" aria-hidden="true">✦</span>
          <span>ShadyGhalabs <small>ANDROID BETA COMMUNITY</small></span>
        </a>
        <a class="home-link" href={base}>Invisible Ink home <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main-content" class="shell">
      <section class="intro" aria-labelledby="hero-title">
        <span class="eyebrow"><span class="dot" aria-hidden="true"></span> EARLY ACCESS · ANDROID</span>
        <h1 id="hero-title">Play early.<br/><span>Shape what’s next.</span></h1>
        <p class="lead">Join a community of curious players. Try new games before their public release and help an independent developer make them better.</p>
        <div class="hero-actions">
          <a class="action primary" href={groupUrl}>1. Join the testing community <span aria-hidden="true">↗</span></a>
          <a class="action secondary" href="#games">Already a member? Choose a game <span aria-hidden="true">↓</span></a>
        </div>
        <p class="small-note">You only need to join the Google Group once. Use the same Google account for every step.</p>
      </section>

      <section class="instructions" aria-label="How testing works">
        <ol class="step-grid">
          <li><span class="step-num">01</span><div><h2>Join once</h2><p>Join our Google Group using the account on your Android phone.</p></div></li>
          <li><span class="step-num">02</span><div><h2>Choose your games</h2><p>Opt in to each game you want to test through Google Play.</p></div></li>
          <li><span class="step-num">03</span><div><h2>Play &amp; share feedback</h2><p>Install, play regularly, and stay enrolled for at least 14 days.</p></div></li>
        </ol>
      </section>

      <section id="games" class="games-section" aria-labelledby="games-title">
        <div class="section-heading">
          <p class="kicker">YOUR NEXT FAVORITE</p>
          <h2 id="games-title">Choose a game to test</h2>
          <p>Try one or both. Each game has its own Google Play opt-in.</p>
        </div>
        <div class="games-grid">
          {games.map((game) => (
            <article class:list={['game', game.id]}>
              <div class="game-art">
                <span class="art-star star-one" aria-hidden="true">✧</span>
                <span class="art-star star-two" aria-hidden="true">✦</span>
                <img src={base + game.icon} alt="" width="112" height="112" loading="eager" />
                <span class="art-label">ANDROID TESTING</span>
              </div>
              <div class="game-body">
                <p class="genre">{game.genre}</p>
                <h3>{game.name}</h3>
                <p class="game-description">{game.description}</p>
                <div class="game-actions">
                  <a class="action game-primary" href={game.testingUrl} aria-label={'Become a tester for ' + game.shortName}>Become a tester <span aria-hidden="true">↗</span></a>
                  <a class="action game-secondary" href={game.storeUrl} aria-label={'Install ' + game.shortName + ' from Google Play after opting in'}>Install from Google Play</a>
                </div>
                <a class="feedback" href={game.feedback} aria-label={'Send feedback for ' + game.shortName}>Send feedback <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="commitment" aria-labelledby="commitment-title">
        <span class="calendar" aria-hidden="true">14<span>DAYS</span></span>
        <div>
          <h2 id="commitment-title">Your feedback makes a difference.</h2>
          <p>Please stay opted in for at least 14 consecutive days. Play the games, try updates, and tell us what works, what feels confusing, and what you would improve. Your real experience matters more than simply installing an app.</p>
        </div>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Need help joining?</h2>
        <details>
          <summary>Google Play says the app is unavailable.</summary>
          <p>Check that you have joined the Google Group, are using the same Google account on your Android phone, and have opted in to the specific game. Access depends on the active testing release, supported devices, and available countries. If you still cannot join, contact the developer.</p>
        </details>
        <details>
          <summary>Do I need to send my email address?</summary>
          <p>No separate email submission is needed on this website. Google Groups and Google Play handle your membership and enrollment.</p>
        </details>
        <details>
          <summary>Can I test both games?</summary>
          <p>Yes. Join the community once, then opt in to each game's test individually. You can install the games after Google Play confirms eligibility.</p>
        </details>
        <details>
          <summary>How can I report a bug?</summary>
          <p>Use the feedback link for the game above. Include your device model, Android version, and what happened. Please avoid sending private account or payment information.</p>
        </details>
      </section>
      <section class="share" aria-labelledby="share-title">
        <div><h2 id="share-title">Know another Android player?</h2><p>Share this single link so they can join the community and choose a game.</p></div>
        <div class="share-actions">
          <a class="share-url" href={portalUrl}>{portalUrl}</a>
          <button class="action secondary copy-button" type="button" hidden>Copy link</button>
          <span class="copy-status" role="status" aria-live="polite"></span>
        </div>
      </section>
    </main>
    <footer class="beta-footer">
      <div class="shell footer-inner">
        <span>Made with care by ShadyGhalabs.</span>
        <a href={base + 'privacy/'}>Privacy</a>
        <a href={groupUrl}>Testing community</a>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.copy-button');
      const link = document.querySelector<HTMLAnchorElement>('.share-url');
      const status = document.querySelector<HTMLElement>('.copy-status');
      if (button && link && status && navigator.clipboard?.writeText) {
        button.hidden = false;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(link.href);
            status.textContent = 'Link copied!';
          } catch {
            status.textContent = 'Copy the link above manually.';
          }
        });
      }
    </script>
  </body>
</html>

<style>
  :global(html) { color-scheme: dark; }
  :global(body) {
    color: #f7f3ff;
    background: radial-gradient(ellipse at 0% 0%, #38205b 0%, transparent 36%),
      radial-gradient(ellipse at 100% 15%, #183557 0%, transparent 32%), #100c1e;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  :global(a:focus-visible), :global(button:focus-visible), :global(summary:focus-visible) {
    outline: 3px solid #f6d98b; outline-offset: 5px;
  }
  :global([hidden]) { display: none !important; }
  .shell { width: min(1080px, 100% - 48px); margin-inline: auto; }
  .skip-link { position: absolute; left: 1rem; top: -7rem; z-index: 3; background: #fff; color: #141021; padding: 1rem; }
  .skip-link:focus { top: 1rem; }
  .beta-header { border-bottom: 1px solid #ffffff18; }
  .header-inner, .footer-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding-block: 1.25rem; }
  .brand { display: flex; gap: .75rem; align-items: center; font-size: 1.05rem; font-weight: 800; }
  .brand small { display: block; color: #cbc0df; letter-spacing: .12em; font-size: .63rem; font-weight: 600; }
  .brand-mark { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 15px; background: linear-gradient(145deg, #8346c8, #4b51a7); font-size: 1.4rem; box-shadow: 0 8px 32px #904cea44; }
  .home-link { color: #ded4f3; font-size: .9rem; text-decoration: underline; text-underline-offset: 4px; }
  .intro { padding: clamp(3rem, 8vw, 6rem) 0 2.6rem; max-width: 780px; }
  .eyebrow { display: inline-flex; align-items: center; gap: .6rem; border: 1px solid #bda2ff54; border-radius: 999px; padding: .5rem .9rem; color: #e3d5ff; font-size: .72rem; letter-spacing: .13em; font-weight: 750; }
  .dot { width: 9px; height: 9px; background: #83e3b8; border-radius: 50%; }
  h1 { margin: 1.2rem 0; font-size: clamp(3rem, 8vw, 6rem); line-height: 1.04; letter-spacing: -.055em; }
  h1 span { color: #dfbcff; }
  .lead { max-width: 640px; font-size: clamp(1.05rem, 2vw, 1.3rem); color: #ded6ef; line-height: 1.65; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.8rem; }
  .action { display: inline-flex; justify-content: center; align-items: center; gap: .55rem; text-align: center; min-height: 50px; padding: .75rem 1.2rem; font: inherit; font-weight: 700; border-radius: 13px; border: 1px solid transparent; cursor: pointer; }
  .action:hover { filter: brightness(1.12); }
  .primary { background: #e5d0ff; color: #24143a; }
  .secondary { background: #201a35; border-color: #776695; color: #f7f3ff; }
  .small-note { margin-top: 1rem; color: #d3c7e6; font-size: .94rem; }
  .instructions { border: 1px solid #bfa4ff26; background: #191329b3; border-radius: 23px; padding: 1.5rem; }
  .step-grid { list-style: none; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.5rem; }
  .step-grid li { display: flex; align-items: flex-start; gap: .9rem; }
  .step-num { display: grid; place-items: center; flex: 0 0 39px; height: 39px; font-size: .9rem; font-weight: 800; color: #e5c8ff; background: #42305e; border-radius: 12px; }
  .step-grid h2 { font-size: 1rem; margin: .1rem 0 .35rem; letter-spacing: -.01em; }
  .step-grid p, .game-description, .section-heading p, .faq p, .commitment p, .share p { color: #d2c8e4; font-size: .98rem; line-height: 1.65; }
  .games-section { padding: 3rem 0; scroll-margin-top: 1rem; }
  .kicker { letter-spacing: .13em; color: #d5b8ff !important; font-weight: 750; font-size: .76rem !important; margin-bottom: .6rem; }
  .section-heading h2 { font-size: clamp(1.8rem, 4vw, 2.75rem); margin-bottom: .6rem; }
  .games-grid { margin-top: 1.5rem; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.3rem; }
  .game { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid #bba2ea40; border-radius: 24px; background: #19142a; }
  .game-art { position: relative; display: grid; place-items: center; min-height: 210px; background: radial-gradient(ellipse at 50% 60%, #9e54e990, transparent 65%), linear-gradient(140deg,#372259,#18264c); overflow: hidden; }
  .teddy-dreams .game-art { background: radial-gradient(ellipse at 50% 60%,#ffbc7a80,transparent 67%),linear-gradient(140deg,#774265,#503147); }
  .game-art img { position: relative; width: 112px; height: 112px; border-radius: 25%; box-shadow: 0 14px 40px #09041599; object-fit: cover; }
  .art-label { position: absolute; top: 15px; left: 17px; padding: .3rem .65rem; border-radius: 99px; background: #0e0b1bbf; color: #fff; font-size: .68rem; font-weight: 700; letter-spacing: .08em; }
  .art-star { color: #fff4cc; position: absolute; opacity: .75; font-size: 2rem; }
  .star-one { top: 26%; right: 17%; } .star-two { bottom: 16%; left: 17%; font-size: 1.2rem; }
  .game-body { display: flex; flex: 1; flex-direction: column; gap: .75rem; padding: 1.5rem; }
  .genre { color: #dfc5ff; font-size: .78rem; font-weight: 700; }
  .teddy-dreams .genre { color: #ffcfab; }
  .game h3 { font-size: clamp(1.35rem,3vw,1.8rem); }
  .game-actions { display: grid; gap: .65rem; margin-top: auto; padding-top: .7rem; }
  .game-primary { background: #d9c2ff; color: #251640; }
  .teddy-dreams .game-primary { background: #ffdaa9; color: #38202c; }
  .game-secondary { color: #f5edff; background: #241d39; border-color: #695b86; }
  .feedback { font-size: .9rem; color: #ded0ff; text-decoration: underline; text-underline-offset: 4px; align-self: flex-start; margin-top: .4rem; }
  .commitment, .share { display: flex; align-items: center; gap: 1.5rem; padding: 1.75rem; border-radius: 22px; border: 1px solid #bba2ea33; background: #211930; }
  .commitment h2, .share h2 { font-size: 1.3rem; margin-bottom: .55rem; }
  .calendar { flex: 0 0 88px; height: 88px; display: grid; align-content: center; text-align: center; border: 1px solid #9c7dc8; border-radius: 20px; color: #f5d9ff; font-size: 2.35rem; font-weight: 800; line-height: 1; background: #3b2b55; }
  .calendar span { font-size: .65rem; letter-spacing: .13em; margin-top: .35rem; }
  .faq { padding: 3rem 0; }
  .faq h2 { font-size: 1.8rem; margin-bottom: 1rem; }
  details { border-bottom: 1px solid #ffffff24; }
  summary { cursor: pointer; padding: 1.1rem .25rem; font-weight: 700; color: #f4edff; min-height: 48px; }
  details p { padding: 0 .25rem 1.1rem; max-width: 800px; }
  .share { flex-wrap: wrap; justify-content: space-between; }
  .share-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; max-width: 100%; }
  .share-url { color: #eadbff; text-decoration: underline; overflow-wrap: anywhere; }
  .copy-status { flex-basis: 100%; font-size: .85rem; color: #e3d5f7; }
  .beta-footer { margin-top: 2.5rem; border-top: 1px solid #ffffff18; }
  .footer-inner { justify-content: flex-start; gap: 1.2rem; color: #d2c6e4; font-size: .85rem; }
  .footer-inner a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) {
    .step-grid { grid-template-columns: 1fr; gap: 1.1rem; }
    .games-grid { grid-template-columns: 1fr; }
    .hero-actions { display: grid; }
    .commitment { align-items: flex-start; }
  }
  @media (max-width: 420px) {
    .shell { width: calc(100% - 32px); }
    .header-inner { gap: .8rem; }
    .intro { padding-top: 2.5rem; }
    .commitment { flex-direction: column; }
    .calendar { flex: none; width: 80px; height: 80px; }
    .game-body { padding: 1.15rem; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>
