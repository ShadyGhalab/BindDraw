---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import appIcon from '../assets/app-icon.png';
const smallIcon = await getImage({src: appIcon, width: 176, format: 'webp'});
const oneLink = import.meta.env.PUBLIC_APPSFLYER_ONELINK_URL ?? 'https://blinddraw.onelink.me/hJLi/private-match';
const appStoreURL = 'https://apps.apple.com/app/id6758377109';
---
<BaseLayout title="Your Daily Drawing Challenge — Invisible Ink" description="Play the same daily drawing challenge as your friend in Invisible Ink on iPhone and iPad.">
  <section class="daily-invite container">
    <img src={smallIcon.src} width="88" height="88" alt="" />
    <p class="section-label">Your turn to draw</p>
    <h1>A little creativity.<br />A shared challenge.</h1>
    <p id="invitation-date"></p>
    <p id="invitation-status" role="status">Open this invitation in Invisible Ink to play the same prompt and difficulty as your friend.</p>
    <div class="daily-invite__actions">
      <a id="open-daily" class="btn btn--primary" aria-disabled="true">Open the challenge</a>
      <a id="install-daily" href={appStoreURL} class="btn btn--secondary">Get Invisible Ink</a>
    </div>
    <p class="daily-invite__help">Installing first? Return to this link after installation, then tap Open the challenge.</p>
  </section>
  <script define:vars={{oneLink, appStoreURL}}>
    const params = new URLSearchParams(location.search);
    const keys = ['dc_day', 'dc_version', 'dc_prompt', 'dc_level'];
    const values = Object.fromEntries(keys.map(key => [key, params.getAll(key).length === 1 ? params.get(key) : null]));
    const valid = /^\d{4}-\d{2}-\d{2}$/.test(values.dc_day ?? '') && values.dc_version === '1'
      && (values.dc_prompt?.length ?? 0) > 0 && (values.dc_prompt?.length ?? 0) <= 96
      && ['easy', 'medium', 'hard'].includes(values.dc_level);
    const open = document.getElementById('open-daily');
    const install = document.getElementById('install-daily');
    if (valid) {
      const app = new URL('invisibleink://daily-challenge');
      const web = new URL('/daily-challenge', location.origin);
      keys.forEach(key => { app.searchParams.set(key, values[key]); web.searchParams.set(key, values[key]); });
      open?.setAttribute('href', app.href);
      open?.removeAttribute('aria-disabled');
      document.getElementById('invitation-date').textContent = values.dc_day;
      if (oneLink) {
        try {
          const deferred = new URL(oneLink);
          if (deferred.protocol === 'https:') {
            deferred.searchParams.set('deep_link_value', 'daily_sketchbook');
            ['dc_day', 'dc_version', 'dc_prompt', 'dc_level'].forEach((key, i) => deferred.searchParams.set(`deep_link_sub${i + 1}`, values[key]));
            deferred.searchParams.set('af_dp', app.href);
            deferred.searchParams.set('af_web_dp', web.href);
            install?.setAttribute('href', deferred.href);
          }
        } catch { /* The App Store and return-to-link path remain available. */ }
      }
    } else {
      document.getElementById('invitation-status').textContent = 'This invitation is incomplete. Ask your friend to share the challenge again.';
    }
  </script>
</BaseLayout>
<style>
.daily-invite { min-height: 85svh; padding-top: 150px; padding-bottom: 80px; text-align: center; max-width: 760px; }
.daily-invite img { border-radius: 22px; margin: 0 auto 1.5rem; }
.daily-invite h1 { font-size: clamp(2.5rem, 7vw, 4.5rem); margin: 1rem 0 2rem; }
.daily-invite p { max-width: 600px; margin: 1rem auto; }
.daily-invite__actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin: 2rem 0; }
.daily-invite__help { font-size: .9rem; }
[aria-disabled="true"] { opacity: .5; pointer-events: none; }
</style>
